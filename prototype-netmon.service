[Unit]
Description=NetMon Silent Network Monitoring Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/local/bin/netmon --daemonize --pidfile /var/run/netmon.pid
ExecStop=/bin/kill -TERM $MAINPID
PIDFile=/var/run/netmon.pid
Restart=on-failure
RestartSec=30
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BROADCAST
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BROADCAST
ReadWritePaths=/var/lib/netmon /var/log/netmon.log

[Install]
WantedBy=multi-user.target